# Port the Express backend listens on (defaults to 9000 for development)
PORT=9000

# Log level for pino (trace | debug | info | warn | error | fatal)
LOG_LEVEL=debug

# AI provider (chat completions) configuration
# Uses Google Gemini via its OpenAI-compatible endpoint.
# Get a free API key at https://aistudio.google.com/apikey (no credit card required).
AI_API_KEY=your-gemini-api-key
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_MODEL=gemini-2.0-flash

# Secret used to sign authentication JWTs (HS256).
# Generate your own with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=4sbMbI5DwZlFild0uKR7ecMrNXAeco6r5lETBYihMpc2WmMQY52DAHddqaJUM-vF
