# Port the Express backend listens on (defaults to 9000 for development)
PORT=9000

# Log level for pino (trace | debug | info | warn | error | fatal)
LOG_LEVEL=debug

CLIENT_ORIGIN=http://localhost:4200

# Secret used to sign authentication JWTs (HS256).
# Generate your own with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=4sbMbI5DwZlF...

GOOGLE_CLIENT_ID=your-google-client-id

# AI provider configuration
AI_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=google/gemma-4-26B-A4B-it
AI_API_KEY=your api key




